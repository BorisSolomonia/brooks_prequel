{$DOMAIN:localhost} {
    # Next.js fingerprints filenames under /_next/static, so they're safe to cache forever.
    @nextStatic path /_next/static/*
    header @nextStatic Cache-Control "public, max-age=31536000, immutable"

    # The image-optimization endpoint (/_next/image?url=...) caches keyed by query string.
    @nextImage path /_next/image*
    header @nextImage Cache-Control "public, max-age=86400"

    handle /api/auth/* {
        reverse_proxy web:3000
    }
    handle /api/exchange-rates* {
        reverse_proxy web:3000
    }
    handle /api/calendar/* {
        reverse_proxy web:3000
    }
    handle /api/trips/* {
        reverse_proxy web:3000
    }
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /actuator/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy web:3000
    }
}
