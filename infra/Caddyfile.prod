{
  email {$LETSENCRYPT_EMAIL}
}

http://127.0.0.1 {
  @health path /health
  respond @health "OK" 200
}

{$DOMAIN} {
  encode gzip zstd

  @health path /health
  respond @health "OK" 200

  # Next.js standalone already emits the right Cache-Control on /_next/static/*; the `?`
  # form sets the header only if upstream didn't, avoiding a duplicate header.
  @nextStatic path /_next/static/*
  header @nextStatic ?Cache-Control "public, max-age=31536000, immutable"

  # The image-optimization endpoint (/_next/image?url=...) caches keyed by query string.
  @nextImage path /_next/image*
  header @nextImage ?Cache-Control "public, max-age=86400"

  @auth path /api/auth/*
  reverse_proxy @auth {$WEB_HOST}:{$WEB_PORT}

  @exchangeRates path /api/exchange-rates*
  reverse_proxy @exchangeRates {$WEB_HOST}:{$WEB_PORT}

  @calendar path /api/calendar/*
  reverse_proxy @calendar {$WEB_HOST}:{$WEB_PORT}

  @tripCalendar path /api/trips/*
  reverse_proxy @tripCalendar {$WEB_HOST}:{$WEB_PORT}

  @api path /api/*
  reverse_proxy @api {$BACKEND_HOST}:{$BACKEND_PORT}

  reverse_proxy {$WEB_HOST}:{$WEB_PORT}

  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Next.js emits inline hydration scripts by default; eliminating 'unsafe-inline'
    # requires nonce-injection middleware (https://nextjs.org/docs/app/building-your-application/configuring/content-security-policy)
    # which we have not wired up yet. Until then 'unsafe-inline' on script-src is the
    # documented Next.js fallback. Remove it once a nonce middleware ships.
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.googleusercontent.com https://storage.googleapis.com https://api.mapbox.com https://*.tiles.mapbox.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://api.mapbox.com; style-src 'self' 'unsafe-inline' https://api.mapbox.com; font-src 'self' data:; connect-src 'self' https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://*.auth0.com; worker-src 'self' blob:; frame-ancestors 'self'"
  }
}
