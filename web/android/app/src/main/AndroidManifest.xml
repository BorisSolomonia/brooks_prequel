<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links for brooksweb.uk. Pairs with
              /.well-known/assetlinks.json (real Play + upload SHA-256s) hosted
              at https://brooksweb.uk so Android auto-opens the Brooks app
              instead of the system browser whenever a brooksweb.uk URL is
              opened (Auth0 sign-in callback, logout returnTo, shared links).
              autoVerify="true" causes Android to fetch and validate the
              assetlinks file on install.

              We use `pathPrefix="/"` to cover EVERY brooksweb.uk path — the
              previous narrow `pathPrefix="/api/auth/callback"` only caught the
              login callback, so the post-logout returnTo to `https://brooksweb.uk`
              would strand the user in Chrome on the web page instead of
              returning to the app. The app is a wrapped-website client, so
              owning every brooksweb.uk link is the correct behaviour.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="brooksweb.uk" android:pathPrefix="/" />
            </intent-filter>

            <!--
              Custom URI scheme for the Auth0 deep-link handover. When Auth0
              redirects the Custom Tab to uk.brooksweb.app://auth/callback?...,
              Android opens the Brooks app and dispatches the URI to the
              @capacitor/app plugin's appUrlOpen event. Our JS listener (see
              src/lib/capacitor.ts) then navigates the WebView to
              /api/auth/callback with the code+state so the SDK can complete
              the OAuth flow inside the WebView's cookie jar.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uk.brooksweb.app" android:host="auth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- WebView + Capacitor plugins -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Android 13+ runtime permission. The @capacitor/push-notifications
      plugin requests this at first use; declaring it here is required for
      the system prompt to appear.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Location permissions for the /maps page. ACCESS_FINE_LOCATION gives
      the precise GPS location used when the user creates a memory. The
      coarse fallback is granted if the user picks "approximate location"
      in the system dialog. BOTH must be declared here for navigator
      .geolocation in the WebView to actually surface the system prompt
      — without these, the request is silently denied and the app's entry
      in Settings → Apps shows no Location tab at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Camera for the guide place-photo "Capture" option (@capacitor/camera).
      The plugin requests this at first use; declaring it here lets the system
      prompt appear. The feature is marked NOT required so the app still installs
      on camera-less devices — capture just falls back to the library/web picker.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
